# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_THINKING_ENABLED=false

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Cost guard
GLOBAL_DAILY_ANALYSIS_LIMIT=1000
GLOBAL_DAILY_RESUME_LIMIT=1000
RESUME_PLAN_DEVICE_DAILY_LIMIT=20
RESUME_PLAN_IP_WINDOW_LIMIT=10
RESUME_PLAN_COOLDOWN_SECONDS=8
# 0 表示不限次；获客阶段可关闭用户级分析次数限制
ANALYSIS_IP_LIMIT=0
ANALYSIS_DEVICE_LIMIT=0

# Public comments
COMMENT_DB_PATH=./.data/comments.sqlite
COMMENT_ADMIN_TOKEN=replace-with-a-long-random-token
COMMENT_HASH_SECRET=replace-with-a-separate-long-random-secret

# Anonymous funnel analytics
ANALYTICS_DB_PATH=./.data/analytics.sqlite
ANALYTICS_ADMIN_TOKEN=replace-with-a-long-random-token
ANALYTICS_HASH_SECRET=replace-with-a-separate-long-random-secret

# Private post-interview feedback
FEEDBACK_DB_PATH=./.data/feedback.sqlite
FEEDBACK_ADMIN_TOKEN=replace-with-a-long-random-token
FEEDBACK_HASH_SECRET=replace-with-a-separate-long-random-secret

# Optional user workspace
USER_DB_PATH=./.data/users.sqlite
SESSION_SECRET=replace-with-a-long-random-session-secret
USER_DATA_ENCRYPTION_KEY=reserved-for-user-data-encryption
